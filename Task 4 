#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILENAME "accounts.dat"
#define MAX_NAME 50
#define MAX_TRANSACTION 100000000.0 // 10 Crore upper bound to prevent precision/overflow issues

typedef struct {
    int accountNumber;
    char holderName[MAX_NAME];
    double balance;
} Account;

void clearInputBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) {}
}

void readLine(char *buffer, size_t size) {
    if (fgets(buffer, (int)size, stdin) != NULL) {
        size_t len = strlen(buffer);
        if (len > 0 && buffer[len - 1] == '\n') {
            buffer[len - 1] = '\0';
        } else {
            clearInputBuffer();
        }
    } else {
        buffer[0] = '\0';
    }
}

int readInt(const char *prompt) {
    int value;
    while (1) {
        printf("%s", prompt);
        if (scanf("%d", &value) == 1) {
            clearInputBuffer();
            return value;
        }
        printf("Invalid input. Please enter a valid integer.\n");
        clearInputBuffer();
    }
}

double readDouble(const char *prompt, double minVal, double maxVal) {
    double value;
    while (1) {
        printf("%s", prompt);
        if (scanf("%lf", &value) == 1) {
            clearInputBuffer();
            if (value >= minVal && value <= maxVal) {
                return value;
            }
            printf("Out of bounds: Please enter an amount between %.2lf and %.2lf.\n", minVal, maxVal);
        } else {
            printf("Invalid input. Please enter a valid numeric amount.\n");
            clearInputBuffer();
        }
    }
}

void createAccount(void) {
    Account acc, temp;

    acc.accountNumber = readInt("Enter New Account Number (positive integer): ");
    if (acc.accountNumber <= 0) {
        printf("Out of bounds: Account Number must be greater than 0.\n");
        return;
    }

    FILE *checkFp = fopen(FILENAME, "rb");
    if (checkFp != NULL) {
        while (fread(&temp, sizeof(Account), 1, checkFp) == 1) {
            if (temp.accountNumber == acc.accountNumber) {
                printf("Error: Account number %d already exists.\n", acc.accountNumber);
                fclose(checkFp);
                return;
            }
        }
        fclose(checkFp);
    }

    printf("Enter Account Holder Name (max %d chars): ", MAX_NAME - 1);
    readLine(acc.holderName, sizeof(acc.holderName));
    if (strlen(acc.holderName) == 0) {
        printf("Error: Account Holder Name cannot be empty.\n");
        return;
    }

    acc.balance = readDouble("Enter Initial Deposit Amount (0 - 100000000): ", 0.0, MAX_TRANSACTION);

    FILE *fp = fopen(FILENAME, "ab");
    if (fp == NULL) {
        perror("Error opening file");
        return;
    }

    if (fwrite(&acc, sizeof(Account), 1, fp) != 1) {
        perror("Failed to save account");
    } else {
        printf("Account created successfully!\n");
    }
    fclose(fp);
}

void deposit(void) {
    FILE *fp = fopen(FILENAME, "rb+");
    if (fp == NULL) {
        printf("No accounts found. Please create an account first.\n");
        return;
    }

    int accNo = readInt("Enter Account Number: ");
    if (accNo <= 0) {
        printf("Out of bounds: Account Number must be greater than 0.\n");
        fclose(fp);
        return;
    }

    int found = 0;
    Account acc;
    while (fread(&acc, sizeof(Account), 1, fp) == 1) {
        if (acc.accountNumber == accNo) {
            double amount = readDouble("Enter Amount to Deposit: ", 0.01, MAX_TRANSACTION);
            acc.balance += amount;

            if (fseek(fp, -(long)sizeof(Account), SEEK_CUR) != 0 ||
                fwrite(&acc, sizeof(Account), 1, fp) != 1) {
                perror("Error updating balance");
            } else {
                printf("Deposit successful! Updated Balance: %.2lf\n", acc.balance);
            }
            found = 1;
            break;
        }
    }

    if (!found) {
        printf("Account %d not found.\n", accNo);
    }
    fclose(fp);
}

void withdraw(void) {
    FILE *fp = fopen(FILENAME, "rb+");
    if (fp == NULL) {
        printf("No accounts found. Please create an account first.\n");
        return;
    }

    int accNo = readInt("Enter Account Number: ");
    if (accNo <= 0) {
        printf("Out of bounds: Account Number must be greater than 0.\n");
        fclose(fp);
        return;
    }

    int found = 0;
    Account acc;
    while (fread(&acc, sizeof(Account), 1, fp) == 1) {
        if (acc.accountNumber == accNo) {
            printf("Current Balance: %.2lf\n", acc.balance);
            if (acc.balance <= 0.0) {
                printf("Insufficient balance to withdraw.\n");
                found = 1;
                break;
            }

            double amount = readDouble("Enter Amount to Withdraw: ", 0.01, acc.balance);
            acc.balance -= amount;

            if (fseek(fp, -(long)sizeof(Account), SEEK_CUR) != 0 ||
                fwrite(&acc, sizeof(Account), 1, fp) != 1) {
                perror("Error updating balance");
            } else {
                printf("Withdrawal successful! Remaining Balance: %.2lf\n", acc.balance);
            }
            found = 1;
            break;
        }
    }

    if (!found) {
        printf("Account %d not found.\n", accNo);
    }
    fclose(fp);
}

void balanceEnquiry(void) {
    FILE *fp = fopen(FILENAME, "rb");
    if (fp == NULL) {
        printf("No accounts found.\n");
        return;
    }

    int accNo = readInt("Enter Account Number: ");
    if (accNo <= 0) {
        printf("Out of bounds: Account Number must be greater than 0.\n");
        fclose(fp);
        return;
    }

    int found = 0;
    Account acc;
    while (fread(&acc, sizeof(Account), 1, fp) == 1) {
        if (acc.accountNumber == accNo) {
            acc.holderName[MAX_NAME - 1] = '\0';
            printf("\n--- Account Details ---\n");
            printf("Account Number : %d\n", acc.accountNumber);
            printf("Holder Name    : %s\n", acc.holderName);
            printf("Current Balance: %.2lf\n", acc.balance);
            found = 1;
            break;
        }
    }

    if (!found) {
        printf("Account %d not found.\n", accNo);
    }
    fclose(fp);
}

int main(void) {
    int choice;
    while (1) {
        printf("\n=== BANK ACCOUNT MANAGEMENT SYSTEM ===\n");
        printf("1. Create New Account\n");
        printf("2. Deposit\n");
        printf("3. Withdraw\n");
        printf("4. Balance Enquiry\n");
        printf("5. Exit\n");
        choice = readInt("Enter your choice (1-5): ");

        switch (choice) {
            case 1: createAccount(); break;
            case 2: deposit(); break;
            case 3: withdraw(); break;
            case 4: balanceEnquiry(); break;
            case 5:
                printf("Thank you for using the Banking System. Goodbye!\n");
                return 0;
            default:
                printf("Out of bounds: Please choose an option between 1 and 5.\n");
        }
    }
}
